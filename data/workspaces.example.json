{
  "workspaces": [
    {
      "name": "agent-v2",
      "path": "E:\\",
      "description": "Local Codex / Agent V2 workspace",
      "areas": [
        {"name": "agents", "path": ".agents", "description": "Agent definitions"},
        {"name": "codex", "path": ".codex", "description": "Codex configuration/context"},
        {"name": "memory", "path": "memory", "description": "Long-term memory files"},
        {"name": "workbench", "path": "workbench", "description": "Projects and active work"},
        {"name": "skills", "path": "skills", "description": "Reusable skills"},
        {"name": "prompts", "path": "prompts", "description": "Prompt assets"},
        {"name": "docs", "path": "docs", "description": "Documentation"},
        {"name": "sources", "path": "sources", "description": "Source/reference material"},
        {"name": "state", "path": "state", "description": "Agent state"}
      ],
      "root_files": ["AGENTS.md", "CLAUDE.md", "IDENTITY.md", "MEMORY.md", "SOUL.md", "START-HERE.md", "TOOLS.md", "USER.md"]
    }
  ],
  "security": {
    "max_file_bytes": 300000,
    "max_search_file_bytes": 1000000,
    "max_walk_files": 50000,
    "excluded_dirs": ["secrets", "private", ".env-data", ".ssh"],
    "excluded_file_patterns": [".env", ".env.*", "*.pem", "*.p12", "*.pfx", "*.key", "id_rsa*", "id_ed25519*", "credentials.json", "credentials.*.json", "service-account*.json"]
  }
}
